# LOCAL DEVELOPMENT ONLY. Dev placeholders, not real credentials.
# Copy to .env and adjust. Never commit .env or real secrets.

DATABASE_URL=postgresql://isms_app:dev-placeholder-app-password@localhost:5432/isms
# Owner role: migrations (pnpm db:migrate); at runtime only with DEMO_TOOLS_ENABLED=true.
DATABASE_OWNER_URL=postgresql://isms_owner:dev-placeholder-owner-password@localhost:5432/isms
# Integration tests only (database isms_test).
DATABASE_TEST_URL=postgresql://isms_app:dev-placeholder-app-password@localhost:5432/isms_test
DATABASE_OWNER_TEST_URL=postgresql://isms_owner:dev-placeholder-owner-password@localhost:5432/isms_test
REDIS_URL=redis://localhost:6379

OIDC_ISSUER_URL=http://localhost:8080/realms/isms
OIDC_AUDIENCE=isms-api
OIDC_CLIENT_ID=isms-web
OIDC_CLIENT_SECRET=dev-placeholder-client-secret

WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
SESSION_SECRET=dev-placeholder-session-secret-not-for-production-use

# Optional
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
METRICS_PORT=9464
# Worker: liveness (GET /healthz) and Prometheus metrics use separate ports.
WORKER_HEALTH_PORT=9465
WORKER_METRICS_PORT=9466
API_PORT=4000
RATE_LIMIT_PER_MINUTE=120
# Per-IP ceiling across all tokens. THROTTLE_TRUSTED_IPS (comma-separated, e.g. the BFF) skips only this limit.
RATE_LIMIT_PER_IP_PER_MINUTE=600
THROTTLE_TRUSTED_IPS=
# "false", or the number of trusted reverse-proxy hops in front of the API (1-10).
TRUST_PROXY=false
# The first sign-in with this verified email becomes organisation administrator (ADR-0004).
# Unset it after first setup: it applies again whenever no administrator exists.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test

# Demo and training tools (Setup -> "Demo and training", pnpm demo:load / demo:reset): load a
# sample year or reset everything. Needs BOOTSTRAP_ADMIN_EMAIL and DATABASE_OWNER_URL. Only on
# an instance with its own database, evidence bucket and Redis: a reset deletes all of them.
# See docs/operations/local-development.md, "Demo mode".
DEMO_TOOLS_ENABLED=false

# AI gateway: "openrouter" (default) or "mock" (tests only; refused in production).
AI_PROVIDER=openrouter
# Encrypts the provider key stored in the database. Generate one with: openssl rand -base64 32
# AI_SECRETS_KEY=
# Development only, refused in production: lets AI run with EU-only routing off (zero retention stays required).
# AI_ALLOW_NON_EU_ROUTING=true

# Evidence storage: the local MinIO from compose (bucket created by compose).
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=isms-evidence
S3_ACCESS_KEY_ID=isms-minio
S3_SECRET_ACCESS_KEY=dev-placeholder-minio-password
S3_FORCE_PATH_STYLE=true
EVIDENCE_MAX_BYTES=26214400
# Local development only: where the embedding model is downloaded (relative to the working
# directory). The worker image sets its own absolute path (/app/.cache/models) with the model
# baked in; compose and production must not override it.
EMBEDDINGS_CACHE_DIR=.cache/models

# --- Local Docker environment (infrastructure/docker/compose.yaml) ---
# Dev-only placeholders. Host ports can be overridden if they are already taken.

POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-placeholder-postgres-superuser-password
ISMS_OWNER_PASSWORD=dev-placeholder-owner-password
ISMS_APP_PASSWORD=dev-placeholder-app-password

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=isms-minio
MINIO_ROOT_PASSWORD=dev-placeholder-minio-password

KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=dev-placeholder-keycloak-admin-password
DEV_USER_PASSWORD=dev-placeholder-user-password

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-placeholder-grafana-password
