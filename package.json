{
  "name": "isms",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "setup": "pnpm infra:up && pnpm db:migrate && pnpm db:seed",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format:check": "prettier --check . --config packages/tooling/prettier.config.js",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "db:migrate": "pnpm --filter @isms/database db:migrate",
    "db:migrate:test": "pnpm --filter @isms/database db:migrate:test",
    "db:validate": "pnpm --filter @isms/database db:validate",
    "db:seed": "pnpm --filter @isms/control-library seed",
    "db:seed:test": "pnpm --filter @isms/control-library seed:test",
    "boundaries": "depcruise . --config .dependency-cruiser.cjs",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker/compose.yaml up -d && tsx scripts/wait-for-infra.ts && tsx infrastructure/docker/keycloak/seed-users.ts",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker/compose.yaml down",
    "infra:reset": "docker compose --env-file .env -f infrastructure/docker/compose.yaml down -v && pnpm infra:up",
    "demo:load": "pnpm --filter @isms/demo cli:load",
    "demo:reset": "pnpm --filter @isms/demo cli:reset"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "postgres": "4.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15"
  }
}
