    "/api/v1/library/controls": {
      "get": {
        "summary": "Search and filter the control library, sorted by code",
        "x-permission": "library.read",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "required": false,
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9][a-z0-9.-]*$"
            },
            "required": false,
            "name": "framework",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "unreviewed",
                "reviewed"
