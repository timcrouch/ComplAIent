            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "required": false,
            "name": "likelihood",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
