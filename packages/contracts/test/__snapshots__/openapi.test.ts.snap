      "get": {
        "summary": "Risks the caller may see, newest change first, filtered and paged",
        "x-permission": "risks.read",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/RiskListFilter"
            },
            "required": false,
            "name": "filter",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
