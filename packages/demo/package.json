{
  "name": "@isms/demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "isms-dist": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "isms-build-js",
    "test:integration": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "cli:load": "tsx --env-file=../../.env src/cli/load.ts",
    "cli:reset": "tsx --env-file=../../.env src/cli/reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@isms/config": "workspace:*",
    "@isms/control-library": "workspace:*",
    "@isms/database": "workspace:*",
    "@isms/domain": "workspace:*",
    "@isms/jobs": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@isms/tooling": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
